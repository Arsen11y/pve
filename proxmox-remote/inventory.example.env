# inventory.example.env
# Стенд Павла/ДЭ 09.02.06-2026 после развёртывания PVE-ASDaC-BASH.
# Если VMID отличаются — смотри qm list на Proxmox и исправляй /root/de-inventory.env.

ISP_VMID=10101
HQ_RTR_VMID=10102
HQ_SRV_VMID=10103
HQ_CLI_VMID=10104
BR_RTR_VMID=10105
BR_SRV_VMID=10106

# ISP interfaces
ISP_WAN_IF=enp7s1
ISP_HQ_IF=enp7s2
ISP_BR_IF=enp7s3

# HQ-RTR interfaces
# WAN_TO_ISP — интерфейс к ISP, LAN_TRUNK — интерфейс под VLAN 100/200/999.
HQ_RTR_WAN_IF=enp7s1
HQ_RTR_LAN_IF=enp7s2

# BR-RTR interfaces
BR_RTR_WAN_IF=enp7s1
BR_RTR_LAN_IF=enp7s2

# Server/client interfaces
HQ_SRV_IF=enp7s1
BR_SRV_IF=enp7s1
HQ_CLI_IF=enp7s1

# Addressing
ISP_HQ_IP=172.16.1.1/28
ISP_BR_IP=172.16.2.1/28

HQ_RTR_WAN_IP=172.16.1.2/28
HQ_RTR_WAN_GW=172.16.1.1
HQ_RTR_VLAN100_IP=192.168.100.1/27
HQ_RTR_VLAN200_IP=192.168.200.1/27
HQ_RTR_VLAN999_IP=192.168.99.1/29

BR_RTR_WAN_IP=172.16.2.2/28
BR_RTR_WAN_GW=172.16.2.1
BR_RTR_LAN_IP=192.168.10.1/28

HQ_SRV_IP=192.168.100.2/27
HQ_SRV_GW=192.168.100.1
BR_SRV_IP=192.168.10.2/28
BR_SRV_GW=192.168.10.1

DOMAIN=au-team.irpo
REALM=AU-TEAM.IRPO
SSH_USER=sshuser
NET_ADMIN_USER=net_admin
DEMO_PASS=P@ssw0rd
TZ=Europe/Kaliningrad

# Module 2 baseline variables. Keep task data in inventory, not in scripts.
DOMAIN_PASS=P@ssw0rd
DOMAIN_USERS_PREFIX=user
DOMAIN_USERS_SUFFIX=hq
DOMAIN_USER_TEMPLATE=user{N}hq
USERS_CSV_PATH=/opt/users.csv
HQ_USERS_PREFIX=user
HQ_USERS_COUNT=5
HQ_GROUP=hq
SUDO_LIMITED_COMMANDS=/bin/cat,/bin/grep,/usr/bin/id
RAID_LEVEL=5
RAID_DISK_COUNT=3
RAID_DISK_SIZE_GB=1
RAID_DEVICE=/dev/md0
RAID_MOUNT=/raid5
NFS_DIR=/raid5/nfs
NFS_CLIENT_NET=192.168.200.0/27
NFS_CLIENT_MOUNT=/mnt/nfs
NTP_SERVER_ROLE=inventory-select
TIME_SERVER=isp.au-team.irpo
NTP_SERVER_CANDIDATES=isp,hq-rtr
ANSIBLE_HOSTS=hq-srv,hq-cli,hq-rtr,br-rtr
ANSIBLE_REPORT_DIR=/etc/ansible/PC-INFO
MOODLE_DOMAIN=moodle.au-team.irpo
MOODLE_DB_NAME=moodledb
MOODLE_DB_USER=moodle
MOODLE_DB_PASS=P@ssw0rd
MOODLE_ADMIN_PASS=P@ssw0rd
WEB_AUTH_USER=WEBc
WIKI_DOMAIN=wiki.au-team.irpo
WIKI_COMPOSE_FILE=wiki.yml
WIKI_SERVICE=wiki
WIKI_DB_SERVICE=mariadb
APP_DB_NAME=mediawiki
APP_DB_USER=wiki
APP_DB_PASS=WikiP@ssw0rd
APP_PORT=8080
DNAT_PORT=2024
DNAT_HQ_TARGET=192.168.100.2:2024
DNAT_BR_TARGET=192.168.10.2:2024
REVERSE_PROXY_HOST=hq-rtr.au-team.irpo
HQ_CLI_BROWSER="Yandex Browser"
MON_DOMAIN=mon.au-team.irpo
MON_USER=admin
BACKUP_DIR=/backup
CA_COMMON_NAME="au-team.irpo Demo CA"
PRINTER_NAME=PDF
SYSLOG_DIR=/var/log/remote

# Proxmox network keys for VLAN tag preparation after VM deployment.
HQ_SRV_PVE_NET=net6
HQ_CLI_PVE_NET=net6

# Proxmox network placement:
# ISP: net6 bridge=vmbr0, net7 bridge=vmbr1001, net8 bridge=vmbr1002
# HQ-RTR: net6 bridge=vmbr1001, net7 bridge=vmbr1003
# ISP-HQ: vmbr1001
# ISP-BR: vmbr1002
# HQ-RTR trunk: vmbr1003 without VLAN tag
# HQ-SRV: vmbr1003 tag=100
# HQ-CLI: vmbr1003 tag=200
# BR-SRV: vmbr1004
