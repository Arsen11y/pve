# inventory.example.env
# Скопируй в /root/de-inventory.env на Proxmox или передавай переменные перед curl.
# Проверка VMID: qm list
# Проверка guest-agent: qm agent <VMID> ping

ISP_VMID=101
HQ_RTR_VMID=102
BR_RTR_VMID=103
HQ_SRV_VMID=104
BR_SRV_VMID=105
HQ_CLI_VMID=106

ISP_WAN_IF=ens18
ISP_HQ_IF=ens19
ISP_BR_IF=ens20

# По исправлению из документа: на HQ-RTR могут быть enp7s1/enp7s2.
HQ_RTR_WAN_IF=enp7s1
HQ_RTR_LAN_IF=enp7s2

BR_RTR_WAN_IF=ens18
BR_RTR_LAN_IF=ens19

HQ_SRV_IF=ens18
BR_SRV_IF=ens18
HQ_CLI_IF=ens18

ISP_HQ_IP=172.16.1.1/28
ISP_BR_IP=172.16.2.1/28

HQ_RTR_WAN_IP=172.16.1.2/28
HQ_RTR_WAN_GW=172.16.1.1
HQ_RTR_VLAN100_IP=192.168.100.1/27
HQ_RTR_VLAN200_IP=192.168.200.1/27
HQ_RTR_VLAN999_IP=192.168.99.1/29

BR_RTR_WAN_IP=172.16.2.2/28
BR_RTR_WAN_GW=172.16.2.1
BR_RTR_LAN_IP=192.168.10.1/28

HQ_SRV_IP=192.168.100.2/27
HQ_SRV_GW=192.168.100.1
BR_SRV_IP=192.168.10.2/28
BR_SRV_GW=192.168.10.1

DOMAIN=au-team.irpo
SSH_USER=sshuser
NET_ADMIN_USER=net_admin
DEMO_PASS=P@ssw0rd
TZ=Europe/Moscow
