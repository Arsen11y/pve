# inventory.example.env
# Стенд Павла/ДЭ 09.02.06-2026 после развёртывания PVE-ASDaC-BASH.
# Если VMID отличаются — смотри qm list на Proxmox и исправляй /root/de-inventory.env.

ISP_VMID=10101
HQ_RTR_VMID=10102
HQ_SRV_VMID=10103
HQ_CLI_VMID=10104
BR_RTR_VMID=10105
BR_SRV_VMID=10106

# ISP interfaces
ISP_WAN_IF=enp7s1
ISP_HQ_IF=enp7s2
ISP_BR_IF=enp7s3

# HQ-RTR interfaces
# WAN_TO_ISP — интерфейс к ISP, LAN_TRUNK — интерфейс под VLAN SRV/CLI/MGMT.
HQ_RTR_WAN_IF=enp7s1
HQ_RTR_LAN_IF=enp7s2

# BR-RTR interfaces
BR_RTR_WAN_IF=enp7s1
BR_RTR_LAN_IF=enp7s2

# Server/client interfaces
HQ_SRV_IF=enp7s1
BR_SRV_IF=enp7s1
HQ_CLI_IF=enp7s1

# Variant 3 VLANs
VLAN_SRV=113
VLAN_CLI=213
VLAN_MGMT=813

# Addressing
ISP_HQ_NET=172.16.50.0/28
ISP_HQ_ADDR=172.16.50.1
ISP_HQ_IP=172.16.50.1/28
ISP_BR_NET=172.16.60.0/28
ISP_BR_ADDR=172.16.60.1
ISP_BR_IP=172.16.60.1/28

HQ_RTR_WAN_ADDR=172.16.50.2
HQ_RTR_WAN_IP=172.16.50.2/28
HQ_RTR_WAN_GW=172.16.50.1
BR_RTR_WAN_ADDR=172.16.60.2
BR_RTR_WAN_IP=172.16.60.2/28
BR_RTR_WAN_GW=172.16.60.1

HQ_SRV_NET=192.168.113.0/27
HQ_RTR_SRV_ADDR=192.168.113.1
HQ_RTR_SRV_GW=192.168.113.1/27
HQ_CLI_NET=192.168.213.0/27
HQ_RTR_CLI_ADDR=192.168.213.1
HQ_RTR_CLI_GW=192.168.213.1/27
MGMT_NET=192.168.81.0/29
HQ_RTR_MGMT_ADDR=192.168.81.1
HQ_RTR_MGMT_GW=192.168.81.1/29

BR_RTR_LAN_IP=192.168.10.1/28
BR_RTR_LAN_ADDR=192.168.10.1
BR_SRV_NET=192.168.10.0/28

HQ_SRV_ADDR=192.168.113.2
HQ_SRV_IP=192.168.113.2/27
HQ_SRV_GW=192.168.113.1
HQ_CLI_DHCP_START=192.168.213.10
HQ_CLI_DHCP_END=192.168.213.20
HQ_CLI_ADDR=192.168.213.10
HQ_CLI_EXPECTED_IP=192.168.213.11
BR_SRV_IP=192.168.10.2/28
BR_SRV_ADDR=192.168.10.2
BR_SRV_GW=192.168.10.1

DNS_FORWARDER_1=77.88.8.7
DNS_FORWARDER_2=77.88.8.3
DNS_WEB_IP=172.16.60.1
DNS_DOCKER_IP=172.16.50.1

DOMAIN=au-team.irpo
REALM=AU-TEAM.IRPO
SSH_USER=sshuser
SSH_PASS=P@ssw0rd
SSH_PORT=2013
SSH_UID=2013
ROUTER_ADMIN_USER=net_admin
ROUTER_ADMIN_PASS=P@ssw0rd
NET_ADMIN_USER="$ROUTER_ADMIN_USER"
DEMO_PASS="$SSH_PASS"
TZ=Europe/Kaliningrad

# Module 2 variant 3 baseline variables. Keep task data in inventory, not in scripts.
DOMAIN_PASS=P@ssw0rd
DOMAIN_USERS_PREFIX=user
DOMAIN_USERS_SUFFIX=hq
DOMAIN_USER_TEMPLATE=user{N}hq
DOMAIN_USERS_COUNT=5
USERS_CSV_PATH=/opt/users.csv
HQ_USERS_PREFIX=user
HQ_USERS_SUFFIX=hq
HQ_USERS_COUNT=5
HQ_GROUP=hq
DOMAIN_GROUP=hq
SUDO_LIMITED_COMMANDS=/bin/cat,/bin/grep,/usr/bin/id
RAID_LEVEL=5
RAID_DISK_COUNT=3
RAID_DISK_SIZE_GB=1
RAID_DEVICE=/dev/md0
RAID_MOUNT=/raid5
NFS_DIR=/raid5/nfs
NFS_CLIENT_NET=192.168.213.0/27
NFS_CLIENT_MOUNT=/mnt/nfs
NTP_SERVER_ROLE=ISP
NTP_STRATUM=8
TIME_SERVER=isp.au-team.irpo
NTP_SERVER_CANDIDATES=isp,hq-rtr
ANSIBLE_WORKDIR=/etc/ansible
ANSIBLE_HOSTS=hq-srv,hq-cli,hq-rtr,br-rtr
ANSIBLE_REPORT_DIR=/etc/ansible/PC-INFO
DOCKER_COMPOSE_FILE=wiki.yml
DOCKER_IMAGE_APP=mediawiki
DOCKER_IMAGE_DB=mariadb
DOCKER_APP_CONTAINER=wiki
DOCKER_DB_CONTAINER=mariadb
DOCKER_DB_NAME=mediawiki
DOCKER_DB_USER=wiki
DOCKER_DB_PASS=WikiP@ssw0rd
DOCKER_APP_PORT=8080
APP_PORT=8080
WEB_APP=moodle
WEB_DB_NAME=moodledb
WEB_DB_USER=moodle
WEB_DB_PASS=P@ssw0rd
MOODLE_DB_NAME=moodledb
MOODLE_DB_USER=moodle
MOODLE_DB_PASS=P@ssw0rd
MOODLE_ADMIN_PASS=P@ssw0rd
WEB_DOMAIN=moodle.au-team.irpo
DOCKER_DOMAIN=wiki.au-team.irpo
DNAT_PORT=2024
DNAT_HQ_TARGET=192.168.113.2:2024
DNAT_BR_TARGET=192.168.10.2:2024
SSH_DNAT_PORT=2013
SSH_DNAT_HQ_TARGET=192.168.113.2:2013
SSH_DNAT_BR_TARGET=192.168.10.2:2013
REVERSE_PROXY_HOST=hq-rtr.au-team.irpo
REVERSE_PROXY_VMID=10102
BASIC_AUTH_USER=Kazimirc
BASIC_AUTH_PASS=P@ssw0rd
BASIC_AUTH_FILE=/etc/nginx/.htpasswd
HQ_CLI_BROWSER="Yandex Browser"
MON_DOMAIN=mon.au-team.irpo
MON_USER=admin
BACKUP_DIR=/backup
CA_COMMON_NAME="au-team.irpo Demo CA"
PRINTER_NAME=PDF
SYSLOG_DIR=/var/log/remote

# Proxmox network keys for VLAN tag preparation after VM deployment.
HQ_SRV_PVE_NET=net6
HQ_CLI_PVE_NET=net6

# Proxmox network placement:
# ISP: net6 bridge=vmbr0, net7 bridge=vmbr1001, net8 bridge=vmbr1002
# HQ-RTR: net6 bridge=vmbr1001, net7 bridge=vmbr1003
# ISP-HQ: vmbr1001
# ISP-BR: vmbr1002
# HQ-RTR trunk: vmbr1003 without VLAN tag
# HQ-SRV: vmbr1003 tag=113
# HQ-CLI: vmbr1003 tag=213
# BR-SRV: vmbr1004
