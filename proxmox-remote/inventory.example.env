# inventory.example.env
# Стенд Павла/ДЭ 09.02.06-2026 после развёртывания PVE-ASDaC-BASH.
# Если VMID отличаются — смотри qm list на Proxmox и исправляй /root/de-inventory.env.

ISP_VMID=10101
HQ_RTR_VMID=10102
HQ_SRV_VMID=10103
HQ_CLI_VMID=10104
BR_RTR_VMID=10105
BR_SRV_VMID=10106

# ISP interfaces
ISP_WAN_IF=enp7s1
ISP_HQ_IF=enp7s2
ISP_BR_IF=enp7s3

# HQ-RTR interfaces
# WAN_TO_ISP — интерфейс к ISP, LAN_TRUNK — интерфейс под VLAN 100/200/999.
HQ_RTR_WAN_IF=enp7s1
HQ_RTR_LAN_IF=enp7s2

# BR-RTR interfaces
BR_RTR_WAN_IF=enp7s1
BR_RTR_LAN_IF=enp7s2

# Server/client interfaces
HQ_SRV_IF=enp7s1
BR_SRV_IF=enp7s1
HQ_CLI_IF=enp7s1

# Addressing
ISP_HQ_IP=172.16.1.1/28
ISP_BR_IP=172.16.2.1/28

HQ_RTR_WAN_IP=172.16.1.2/28
HQ_RTR_WAN_GW=172.16.1.1
HQ_RTR_VLAN100_IP=192.168.100.1/27
HQ_RTR_VLAN200_IP=192.168.200.1/27
HQ_RTR_VLAN999_IP=192.168.99.1/29

BR_RTR_WAN_IP=172.16.2.2/28
BR_RTR_WAN_GW=172.16.2.1
BR_RTR_LAN_IP=192.168.10.1/28

HQ_SRV_IP=192.168.100.2/27
HQ_SRV_GW=192.168.100.1
BR_SRV_IP=192.168.10.2/28
BR_SRV_GW=192.168.10.1

DOMAIN=au-team.irpo
SSH_USER=sshuser
NET_ADMIN_USER=net_admin
DEMO_PASS=P@ssw0rd
TZ=Europe/Moscow

# Proxmox network placement:
# ISP-HQ: vmbr1001
# ISP-BR: vmbr1002
# HQ-RTR trunk: vmbr1003 without VLAN tag
# HQ-SRV: vmbr1003 tag=100
# HQ-CLI: vmbr1003 tag=200
# BR-SRV: vmbr1004
